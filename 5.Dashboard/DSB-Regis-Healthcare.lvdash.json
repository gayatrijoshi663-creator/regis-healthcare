    {
      "name": "f04c2e1b",
      "displayName": "Admissions by Month",
      "queryLines": [
        "SELECT\r\n",
        "d.month_name,\r\n",
        "d.year,\r\n",
        "COUNT(*) AS admissions\r\n",
        "FROM fact_admissions f\r\n",
        "JOIN dim_date d\r\n",
        "ON f.admission_date_key=d.date_key\r\n",
        "GROUP BY d.year,d.month_name;"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    },
    {
      "name": "b76c2858",
      "displayName": "Discharges by Month",
      "queryLines": [
        "SELECT\r\n",
        "d.month_name,\r\n",
        "d.year,\r\n",
        "COUNT(*) AS discharges\r\n",
        "FROM fact_discharges f\r\n",
        "JOIN dim_date d\r\n",
        "ON f.discharge_date_key=d.date_key\r\n",
        "GROUP BY d.year,d.month_name;"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    },
    {
      "name": "ee51a0e6",
      "displayName": "Occupancy Rate by Facility",
      "queryLines": [
        "SELECT\r\n",
        "  f.facility_key,\r\n",
        "  f.facility_name,\r\n",
        "  f.capacity,\r\n",
        "  COUNT(DISTINCT a.admission_key) AS total_admissions,\r\n",
        "  COUNT(DISTINCT d.discharge_key) AS total_discharges,\r\n",
        "  (COUNT(DISTINCT a.admission_key) - COUNT(DISTINCT d.discharge_key)) AS current_residents,\r\n",
        "  ROUND(\r\n",
        "    ((COUNT(DISTINCT a.admission_key) - COUNT(DISTINCT d.discharge_key)) * 100.0) / f.capacity,\r\n",
        "    2\r\n",
        "  ) AS occupancy_rate\r\n",
        "FROM\r\n",
        "  regis_healthcare.gold.dim_facilities f\r\n",
        "    LEFT JOIN regis_healthcare.gold.fact_admissions a\r\n",
        "      ON f.facility_key = a.facility_key\r\n",
        "    LEFT JOIN regis_healthcare.gold.fact_discharges d\r\n",
        "      ON f.facility_key = d.facility_key\r\n",
        "GROUP BY\r\n",
        "  f.facility_key,\r\n",
        "  f.facility_name,\r\n",
        "  f.capacity;"
      ]
    },
    {
      "name": "f0d1a749",
      "displayName": "Incident Count by Severity",
      "queryLines": [
        "select d.severity,\r\n",
        "       count(\"*\") as Incident_Count\r\n",
        "         from regis_healthcare.gold.fact_incidents f \r\n",
        "         left join regis_healthcare.gold.dim_incident_type d \r\n",
        "on f.incident_type_key = d.incident_type_key \r\n",
        "group by severity order by Incident_Count ;"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    },
    {
      "name": "d8ae1f2c",
      "displayName": "Facility-wise Incident Count",
      "queryLines": [
        "select d.facility_name,\r\n",
        "  count(*) as  incident_count \r\n",
        "  from fact_incidents f join dim_facilities d \r\n",
        "  on f.facility_key = d.facility_key  \r\n",
        "  join dim_incident_type i\r\n",
        "  on f.incident_type_key = i.incident_type_key \r\n",
        "group by d.facility_name\r\n",
        "       ORDER BY\r\n",
        "    incident_count DESC;"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    },
    {
      "name": "f33b47d9",
      "displayName": "Incident Count Monthly Trend",
      "queryLines": [
        "select \r\n",
        "   d.year,\r\n",
        "   d.month_name,\r\n",
        "   j.severity,\r\n",
        "   count(*) as incident_count\r\n",
        "   FROM fact_incidents i\r\n",
        "JOIN dim_date  d\r\n",
        "ON i.incident_date_key = d.date_key\r\n",
        "join dim_incident_type j\r\n",
        "on j.incident_type_key = i.incident_type_key\r\n",
        "GROUP BY\r\n",
        "    d.year,\r\n",
        "    d.month_name,\r\n",
        "    j.severity\r\n",
        "\r\n",
        "ORDER BY\r\n",
        "    d.year,\r\n",
        "    d.month_name,\r\n",
        "    j.severity;\r\n"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    },
    {
      "name": "d0e98c73",
      "displayName": "Critical Incidents Only",
      "queryLines": [
        "SELECT\r\n",
        "   t.severity,\r\n",
        "    COUNT(*) AS critical_incidents\r\n",
        "FROM fact_incidents i\r\n",
        "join dim_incident_type  t\r\n",
        "on t.incident_type_key = i.incident_type_key\r\n",
        "group by t.severity having severity='Critical';"
      ],
      "catalog": "regis_healthcare",
      "schema": "gold"
    }
  ],
